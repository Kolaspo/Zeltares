---
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Atpūtas nams pie Iecavas · Jelgava</p>
      <h1 class="headline">
        Sauna kurina.<br />
        Kubls burbuļo.<br />
        Ballīte tikko sākas.
      </h1>
      <p class="lede">
        Zeltāres ir naktsmītne un svinību vieta Iecavas upes krastā — sauna, pirts, kubls,
        rotaļu telpa un futbola laukums vienuviet. Vieta dzimšanas dienām, korporatīviem
        pasākumiem un naktīm, kad negribas braukt mājās.
      </p>
      <div class="hero-actions">
        <a href="#kontakti" class="btn-filled">Pieteikt ballīti</a>
        <a href="#kalendars" class="btn-outline">Skatīt brīvos datumus</a>
      </div>
      <div class="hero-stats">
        <div><strong>5</strong><span>atpūtas iespējas</span></div>
        <div><strong>~35</strong><span>viesu vienlaikus</span></div>
        <div><strong>1</strong><span>upes krasts, tikai jūsu</span></div>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 480 460" xmlns="http://www.w3.org/2000/svg" class="scene">
        <defs>
          <radialGradient id="sun" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="var(--color-amber)" />
            <stop offset="100%" stop-color="var(--color-ember)" />
          </radialGradient>
        </defs>

        <!-- sky -->
        <rect x="0" y="0" width="480" height="330" fill="var(--color-pine)" />
        <circle cx="380" cy="90" r="52" fill="url(#sun)" opacity="0.9" />

        <!-- trees -->
        <g fill="var(--color-pine-deep)">
          <polygon points="30,330 60,230 90,330" />
          <polygon points="55,330 90,200 125,330" />
          <polygon points="380,330 405,260 430,330" />
          <polygon points="410,330 440,240 470,330" />
        </g>

        <!-- river -->
        <path d="M0,330 C120,310 150,350 240,335 C330,320 360,350 480,330 L480,460 L0,460 Z" fill="var(--color-moss)" />
        <path d="M0,345 C120,330 150,365 240,352 C330,340 360,365 480,348" fill="none" stroke="var(--color-cream)" stroke-opacity="0.25" stroke-width="3" />

        <!-- dock -->
        <rect x="150" y="352" width="14" height="70" fill="var(--color-pine-deep)" />
        <rect x="300" y="358" width="14" height="64" fill="var(--color-pine-deep)" />
        <rect x="140" y="345" width="190" height="14" fill="var(--color-ember-dark)" />

        <!-- cabin -->
        <g>
          <polygon points="150,260 240,180 330,260" fill="var(--color-pine-deep)" />
          <rect x="160" y="260" width="160" height="95" fill="var(--color-pine-deep)" />
          <rect x="226" y="300" width="28" height="55" fill="var(--color-moss)" />
          <rect x="180" y="285" width="26" height="26" fill="var(--color-amber)" opacity="0.85" />
          <rect x="274" y="285" width="26" height="26" fill="var(--color-amber)" opacity="0.85" />
          <!-- chimney -->
          <rect x="290" y="205" width="16" height="35" fill="var(--color-pine-deep)" />
        </g>

        <!-- steam rings signature motif -->
        <g class="steam" stroke="var(--color-cream)" stroke-width="3" fill="none" opacity="0.55">
          <circle cx="298" cy="185" r="8" />
          <circle cx="298" cy="160" r="12" />
          <circle cx="298" cy="128" r="16" />
        </g>

        <!-- string lights -->
        <g stroke="var(--color-cream)" stroke-opacity="0.4" fill="var(--color-amber)">
          <path d="M40,120 Q240,60 460,120" fill="none" />
          <circle cx="90" cy="110" r="4" />
          <circle cx="160" cy="88" r="4" />
          <circle cx="240" cy="75" r="4" />
          <circle cx="320" cy="88" r="4" />
          <circle cx="400" cy="110" r="4" />
        </g>
      </svg>
    </div>
  </div>

  <div class="wave" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, var(--color-pine) 0%, var(--color-pine-deep) 100%);
    color: var(--color-cream);
    overflow: hidden;
    padding-top: 2.5rem;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .headline {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1.05;
    font-weight: 600;
    margin: 0.6rem 0 1.2rem;
    color: var(--color-cream);
  }

  .lede {
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(244, 237, 225, 0.85);
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    margin-top: 2.6rem;
    flex-wrap: wrap;
  }

  .hero-stats div {
    display: flex;
    flex-direction: column;
  }

  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--color-ember);
  }

  .hero-stats span {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(244, 237, 225, 0.6);
  }

  .hero-art {
    display: flex;
    justify-content: center;
  }

  .scene {
    width: 100%;
    max-width: 480px;
    filter: drop-shadow(var(--shadow-soft));
  }

  .steam circle {
    animation: rise 4s ease-in-out infinite;
    transform-origin: center;
  }

  .steam circle:nth-child(2) {
    animation-delay: 0.6s;
  }
  .steam circle:nth-child(3) {
    animation-delay: 1.2s;
  }

  @keyframes rise {
    0% {
      opacity: 0;
      transform: translateY(6px) scale(0.85);
    }
    35% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: translateY(-18px) scale(1.15);
    }
  }

  .wave {
    height: 40px;
    background: var(--color-cream);
    border-radius: 60% 40% 0 0 / 100% 100% 0 0;
    margin-top: -20px;
  }

  @media (prefers-reduced-motion: reduce) {
    .steam circle {
      animation: none;
      opacity: 0.4;
    }
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.05fr 0.95fr;
      padding-top: 4rem;
    }
  }
</style>
