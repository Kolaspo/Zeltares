---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <span class="wordmark">Zeltāres</span>
        <p>Atpūtas nams pie Iecavas upes, Jelgavas novads.</p>
      </div>

      <nav aria-label="Kājenes navigācija">
        <a href="#pakalpojumi">Ko piedāvājam</a>
        <a href="#cenas">Cenas</a>
        <a href="#par-mums">Par Zeltārēm</a>
        <a href="#galerija">Galerija</a>
        <a href="#kalendars">Brīvie datumi</a>
        <a href="#kontakti">Kontakti</a>
      </nav>

      <div class="social">
        <a href="#" aria-label="Zeltāres Facebook profils">Facebook</a>
        <a href="#" aria-label="Zeltāres Instagram profils">Instagram</a>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} Zeltāres. Visas tiesības aizsargātas.</span>
      <span>Izstrādāts ar ❤ Jelgavas novadā.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-pine-deep);
    color: rgba(244, 237, 225, 0.75);
    padding: 3.2rem 0 1.6rem;
  }

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2.2rem;
    border-bottom: 1px solid rgba(244, 237, 225, 0.12);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-cream);
  }

  .brand p {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    max-width: 34ch;
    line-height: 1.5;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  nav a,
  .social a {
    color: rgba(244, 237, 225, 0.75);
    text-decoration: none;
    font-size: 0.9rem;
  }

  nav a:hover,
  .social a:hover {
    color: var(--color-ember);
  }

  .social {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .bottom {
    padding-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: rgba(244, 237, 225, 0.5);
  }

  @media (min-width: 700px) {
    .top {
      grid-template-columns: 1.3fr 1fr 0.8fr;
    }

    .bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
