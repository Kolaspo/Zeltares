---
const links = [
  { href: '#pakalpojumi', label: 'Ko piedāvājam' },
  { href: '#cenas', label: 'Cenas' },
  { href: '#par-mums', label: 'Par Zeltārēm' },
  { href: '#galerija', label: 'Galerija' },
  { href: '#kalendars', label: 'Brīvie datumi' },
  { href: '#kontakti', label: 'Kontakti' },
];
---

<header class="site-header">
  <div class="bar flex items-center justify-between">
    <a href="#" class="logo flex items-center gap-2">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34">
          <circle cx="20" cy="20" r="20" fill="var(--color-ember)"></circle>
          <path
            d="M20 8c2.4 3.6-1.2 5.4-1.2 8.4 0 1.8 1.2 3 3 3s3-1.2 3-3c1.8 2.4 2.4 4.8 2.4 6.6 0 4.8-3.6 8.4-8.4 8.4S10.4 27.8 10.4 23c0-3.6 1.8-6 3.6-8.4.6 1.8 1.8 2.4 3 1.8-.6-2.4 1.2-5.4 3-8.4z"
            fill="var(--color-pine-deep)"></path>
        </svg>
      </span>
      <span class="wordmark">Zeltāres</span>
    </a>

    <nav class="nav-desktop hidden md:flex items-center gap-7" aria-label="Galvenā navigācija">
      {links.map((l) => (
        <a href={l.href} class="nav-link">{l.label}</a>
      ))}
    </nav>

    <a href="#kontakti" class="btn-filled hidden md:inline-flex cta-desktop">Pieteikt ballīti</a>

    <button id="menu-toggle" class="menu-toggle md:hidden" aria-label="Atvērt izvēlni" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav md:hidden" aria-label="Mobilā navigācija">
    {links.map((l) => (
      <a href={l.href} class="mobile-link">{l.label}</a>
    ))}
    <a href="#kontakti" class="btn-filled mobile-cta">Pieteikt ballīti</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.classList.toggle('open', isOpen);
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  nav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(22, 34, 46, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(244, 237, 225, 0.12);
  }

  .bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
  }

  .logo {
    text-decoration: none;
    color: var(--color-cream);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .nav-link {
    color: var(--color-cream);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    opacity: 0.85;
    position: relative;
    padding-bottom: 4px;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    background: var(--color-ember);
    transition: width 0.25s ease;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .cta-desktop {
    padding: 0.6rem 1.3rem;
    font-size: 0.88rem;
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--color-cream);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.open span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    max-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--color-pine);
    transition: max-height 0.35s ease;
  }

  .mobile-nav.open {
    max-height: 420px;
  }

  .mobile-link {
    color: var(--color-cream);
    text-decoration: none;
    padding: 0.9rem 1.5rem;
    border-top: 1px solid rgba(244, 237, 225, 0.1);
    font-weight: 600;
  }

  .mobile-cta {
    margin: 1rem 1.5rem 1.5rem;
  }

  @media (min-width: 768px) {
    .mobile-nav {
      display: none;
    }
  }
</style>
