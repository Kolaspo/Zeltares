---
---

<section id="kalendars" class="schedule">
  <div class="wrap">
    <p class="eyebrow center">Brīvie datumi</p>
    <h2 class="title">Šī mēneša kalendārs</h2>
    <p class="intro">
      Ātrs ieskats, kuras dienas šomēnes jau aizņemtas ballītēm un naktsmītnei. Precīzu
      pieejamību vienmēr apstiprinām pa telefonu vai e-pastu.
    </p>

    <div class="panel">
      <div class="panel-head">
        <button id="cal-prev" class="nav-btn" aria-label="Iepriekšējais mēnesis" type="button">‹</button>
        <h3 id="cal-month">—</h3>
        <button id="cal-next" class="nav-btn" aria-label="Nākamais mēnesis" type="button">›</button>
      </div>

      <div class="weekdays" id="cal-weekdays"></div>
      <div class="grid" id="cal-grid"></div>

      <div class="legend">
        <span class="legend-item"><i class="dot free"></i> Brīvs</span>
        <span class="legend-item"><i class="dot taken"></i> Aizņemts</span>
        <span class="legend-item"><i class="dot today"></i> Šodien</span>
      </div>

      <p id="cal-selection" class="selection" aria-live="polite">
        Izvēlies brīvu dienu, lai to pieprasītu.
      </p>
      <a id="cal-cta" href="#kontakti" class="btn-filled cal-cta">Pieprasīt izvēlēto datumu</a>
    </div>

    <p class="disclaimer">* Kalendārs ir demonstrācijas nolūkos un neatspoguļo reālo aizņemtību.</p>
  </div>
</section>

<script>
  const monthNames = [
    'Janvāris', 'Februāris', 'Marts', 'Aprīlis', 'Maijs', 'Jūnijs',
    'Jūlijs', 'Augusts', 'Septembris', 'Oktobris', 'Novembris', 'Decembris',
  ];
  const weekdayLabels = ['Pr', 'Ot', 'Tr', 'Ce', 'Pk', 'Se', 'Sv'];

  const monthEl = document.getElementById('cal-month');
  const weekdaysEl = document.getElementById('cal-weekdays');
  const gridEl = document.getElementById('cal-grid');
  const selectionEl = document.getElementById('cal-selection');
  const ctaEl = document.getElementById('cal-cta');
  const prevBtn = document.getElementById('cal-prev');
  const nextBtn = document.getElementById('cal-next');

  const today = new Date();
  let viewYear = today.getFullYear();
  let viewMonth = today.getMonth();
  let selectedDate = null;

  // Deterministic mock "booked" pattern: weekends look busier, plus a
  // handful of scattered weekdays, so every month feels a little different.
  function isBooked(year, month, day) {
    const date = new Date(year, month, day);
    const dow = date.getDay(); // 0 Sun .. 6 Sat
    if (dow === 5 || dow === 6) return true; // Fri & Sat — party nights
    const hash = (day * 31 + (month + 1) * 7 + year) % 11;
    return hash === 0;
  }

  function render() {
    if (!monthEl || !weekdaysEl || !gridEl) return;

    monthEl.textContent = `${monthNames[viewMonth]} ${viewYear}`;
    weekdaysEl.innerHTML = weekdayLabels
      .map((w) => `<span>${w}</span>`)
      .join('');

    const firstDow = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7; // Monday = 0
    const totalDays = new Date(viewYear, viewMonth + 1, 0).getDate();

    let html = '';
    for (let i = 0; i < firstDow; i++) {
      html += '<span class="cell empty" aria-hidden="true"></span>';
    }

    for (let day = 1; day <= totalDays; day++) {
      const booked = isBooked(viewYear, viewMonth, day);
      const isToday =
        day === today.getDate() &&
        viewMonth === today.getMonth() &&
        viewYear === today.getFullYear();
      const iso = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      const classes = ['cell', booked ? 'taken' : 'free', isToday ? 'today' : '']
        .filter(Boolean)
        .join(' ');

      html += `<button type="button" class="${classes}" data-date="${iso}" data-booked="${booked}" ${booked ? 'aria-disabled="true"' : ''}>
        <span class="num">${day}</span>
        ${booked ? '<span class="spark" aria-hidden="true">✦</span>' : ''}
      </button>`;
    }

    gridEl.innerHTML = html;

    gridEl.querySelectorAll('.cell.free').forEach((btn) => {
      btn.addEventListener('click', () => {
        gridEl.querySelectorAll('.cell.selected').forEach((c) => c.classList.remove('selected'));
        btn.classList.add('selected');
        selectedDate = btn.dataset.date ?? null;
        updateSelectionText();
      });
    });
  }

  function updateSelectionText() {
    if (!selectionEl || !selectedDate) return;
    const [y, m, d] = selectedDate.split('-');
    selectionEl.textContent = `Izvēlēts datums: ${d}.${m}.${y} — nospied "Pieprasīt", lai sazinātos ar mums.`;
    if (ctaEl) {
      ctaEl.href = `#kontakti?datums=${selectedDate}`;
    }
  }

  prevBtn?.addEventListener('click', () => {
    viewMonth -= 1;
    if (viewMonth < 0) {
      viewMonth = 11;
      viewYear -= 1;
    }
    render();
  });

  nextBtn?.addEventListener('click', () => {
    viewMonth += 1;
    if (viewMonth > 11) {
      viewMonth = 0;
      viewYear += 1;
    }
    render();
  });

  render();
</script>

<style>
  .schedule {
    background: var(--color-cream);
    padding: 5.5rem 0;
  }

  .wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .center {
    text-align: center;
  }

  .title {
    text-align: center;
    color: var(--color-pine-deep);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 0.5rem 0 0.9rem;
  }

  .intro {
    text-align: center;
    color: rgba(16, 24, 31, 0.7);
    max-width: 52ch;
    margin: 0 auto 2.6rem;
    line-height: 1.6;
  }

  .panel {
    background: var(--color-pine);
    border-radius: 24px;
    padding: 1.8rem 1.4rem 2.2rem;
    box-shadow: var(--shadow-soft);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }

  .panel-head h3 {
    color: var(--color-cream);
    font-size: 1.3rem;
    text-align: center;
    flex: 1;
  }

  .nav-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(244, 237, 225, 0.3);
    background: transparent;
    color: var(--color-cream);
    font-size: 1.2rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .nav-btn:hover {
    background: rgba(244, 237, 225, 0.12);
    transform: scale(1.06);
  }

  .weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    margin-bottom: 0.4rem;
  }

  .weekdays :global(span) {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: rgba(244, 237, 225, 0.55);
    padding-bottom: 0.4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }

  .grid :global(.cell) {
    aspect-ratio: 1;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    border: 1px solid transparent;
  }

  .grid :global(.cell.empty) {
    background: transparent;
  }

  .grid :global(.cell.free) {
    background: var(--color-moss);
    color: var(--color-cream);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
  }

  .grid :global(.cell.free:hover) {
    background: #34495c;
    transform: translateY(-2px);
  }

  .grid :global(.cell.free.selected) {
    background: var(--color-amber);
    color: var(--color-pine-deep);
    font-weight: 700;
    border-color: var(--color-cream);
  }

  .grid :global(.cell.taken) {
    background: rgba(201, 162, 39, 0.55);
    color: var(--color-pine-deep);
    cursor: not-allowed;
  }

  .grid :global(.cell.taken .spark) {
    position: absolute;
    top: 3px;
    right: 5px;
    font-size: 0.6rem;
    color: var(--color-pine-deep);
  }

  .grid :global(.cell.today) {
    box-shadow: inset 0 0 0 2px var(--color-amber);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    justify-content: center;
    margin-top: 1.4rem;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: rgba(244, 237, 225, 0.75);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot.free {
    background: var(--color-moss);
  }

  .dot.taken {
    background: var(--color-ember);
  }

  .dot.today {
    background: var(--color-amber);
  }

  .selection {
    text-align: center;
    color: var(--color-cream);
    font-size: 0.88rem;
    margin-top: 1.4rem;
    min-height: 1.4em;
  }

  .cal-cta {
    display: flex;
    width: fit-content;
    margin: 0.8rem auto 0;
  }

  .disclaimer {
    text-align: center;
    font-size: 0.78rem;
    color: rgba(16, 24, 31, 0.5);
    margin-top: 1.4rem;
  }
</style>
